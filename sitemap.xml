---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

{% for p in site.pages %}
  {% unless p.url == "/sitemap.xml"
    or p.url == "/robots.txt"
    or p.url contains "/assets/"
    or p.robots == "noindex" %}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>
  </url>
  {% endunless %}
{% endfor %}

{% for item in site.gallery %}
  {% unless item.robots == "noindex" %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
  </url>
  {% endunless %}
{% endfor %}

</urlset>
