---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>

<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">

{% for p in site.pages %}
  {% unless p.url == "/sitemap.xml"
    or p.url == "/robots.txt"
    or p.url contains "/assets/"
    or p.robots == "noindex" %}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>
  </url>
  {% endunless %}
{% endfor %}

{% for item in site.gallery %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>

    <image:image>
      <image:loc>{{ site.url }}/assets/gallery/originals/{{ item.file | uri_escape }}</image:loc>
    </image:image>

  </url>
{% endfor %}

</urlset>
